# Database connection (Supabase pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Authentication (Project Settings -> API)
# Used by the backend to sign users up/in and to verify access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Keep "Confirm email" enabled in Supabase Auth -> Providers -> Email so that
# new registrations must verify their La Trobe email address before signing in.

# AUTH_REQUIRED=true enforces token verification on all protected endpoints.
# Set to false only as a temporary rollback switch during deployments.
AUTH_REQUIRED=true

APP_HOST=127.0.0.1
APP_PORT=8000
